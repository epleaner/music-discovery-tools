{
  "name": "soundscape",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "test": "pnpm --filter @soundscape/api test && pnpm --filter @soundscape/server test && pnpm --filter @soundscape/scrapes-db test && pnpm --filter @soundscape/web test",
    "dev": "turbo dev",
    "dev:server": "pnpm --filter @soundscape/server dev",
    "dev:web": "pnpm --filter @soundscape/web dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/node": "^20.10.0",
    "cheerio": "^1.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.7.0",
    "turbo": "^1.11.2",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
