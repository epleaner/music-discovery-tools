{
  "name": "soundscape",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:server": "pnpm --filter @soundscape/server dev",
    "dev:web": "pnpm --filter @soundscape/web dev",
    "dev:extension": "pnpm --filter wxt-react-starter dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @soundscape/db db:generate",
    "db:push": "pnpm --filter @soundscape/db db:push",
    "db:studio": "pnpm --filter @soundscape/db db:studio",
    "api:generate": "orval",
    "api:generate:local": "API_URL=http://localhost:3001 orval"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "msw": "^2.12.1",
    "orval": "^7.16.0",
    "prettier": "^3.6.2",
    "turbo": "^1.11.2",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=18"
  }
}
