{
  "name": "soundscape",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:server": "pnpm --filter @soundscape/server dev",
    "dev:web": "pnpm --filter @soundscape/web dev",
    "dev:extension": "pnpm --filter wxt-react-starter dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "api:generate": "orval",
    "api:generate:local": "API_URL=http://localhost:3001 orval",
    "newsletters-db:verify": "pnpm --filter @soundscape/newsletters-db verify:schema"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/node": "^20.10.0",
    "cheerio": "^1.1.2",
    "msw": "^2.12.1",
    "orval": "^7.16.0",
    "prettier": "^3.6.2",
    "tsx": "^4.7.0",
    "turbo": "^1.11.2",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18"
  }
}
