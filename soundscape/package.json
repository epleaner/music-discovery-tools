{
  "name": "soundscape",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:cloudflare": "pnpm build && pnpm --filter @soundscape/server stage:swagger && pnpm --filter @soundscape/server build:worker",
    "test": "pnpm --filter @soundscape/api test && pnpm --filter @soundscape/server test && pnpm --filter @soundscape/scrapes-db test && pnpm --filter @soundscape/web test",
    "dev": "turbo dev",
    "dev:server": "pnpm --filter @soundscape/server dev",
    "dev:web": "pnpm --filter @soundscape/web dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "@types/node": "^20.10.0",
    "cheerio": "^1.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.7.0",
    "turbo": "1.13.4",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "raw-body@2.5.2>iconv-lite": "^0.6.3",
      "body-parser@1.20.3>iconv-lite": "^0.6.3"
    }
  },
  "engines": {
    "node": "^24.22.0"
  }
}
