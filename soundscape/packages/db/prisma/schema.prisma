// Prisma schema for PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Minimal example model - we'll build this out later
model Message {
  id        String   @id @default(cuid())
  content   String
  from      String
  createdAt DateTime @default(now())
}




