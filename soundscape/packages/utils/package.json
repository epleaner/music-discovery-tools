    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@soundscape/types": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  }
}
