# Local-only newsletter ingest configuration
NEWSLETTER_GMAIL_LABEL=music
NEWSLETTER_DB_PATH=../../data/newsletters.sqlite
NEWSLETTER_ENTITY_CONFIDENCE_THRESHOLD=0.8

# Gmail OAuth credentials for live sync (not required for --dry-run)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=

# pi headless extraction config
PI_LLM_MODEL=gpt-5.4-medium
