{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "./apps/server/railway-build.sh"
  },
  "deploy": {
    "startCommand": "pnpm --filter @soundscape/server start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

