{
  "name": "@soundscape/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "db:generate": "prisma generate --schema=../../packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=../../packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=../../packages/db/prisma/schema.prisma"
  },
  "dependencies": {
    "@soundscape/api": "workspace:*",
    "@soundscape/db": "workspace:*",
    "@trpc/server": "^10.45.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "swagger-ui-express": "^5.0.1",
    "trpc-openapi": "^1.2.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
